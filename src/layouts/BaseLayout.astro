---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  author?: string;
}

const {
  title = 'Fregram Blog',
  description = 'Fregram Blog, unmotivated authors and unfinished projects ...',
  image = '/banner.png',
  type = 'website',
  publishedTime,
  author
} = Astro.props;
const pageTitle = title === 'Fregram Blog' ? title : `${title} | Fregram Blog`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/avatar.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0e0f17" />
    <link rel="alternate" type="application/rss+xml" title="Fregram Blog" href="/rss.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {author && <meta name="author" content={author} />}
    <title>{pageTitle}</title>
    <script is:inline>
      function loadAnalytics() {
        if (window.__analyticsLoaded) return;
        window.__analyticsLoaded = true;
        window.dataLayer = window.dataLayer || [];
        window.gtag = function(){window.dataLayer.push(arguments);};
        window.gtag('js', new Date());
        window.gtag('config', 'G-6HMN5C081C', { anonymize_ip: true });
        const script = document.createElement('script');
        script.async = true;
        script.src = 'https://www.googletagmanager.com/gtag/js?id=G-6HMN5C081C';
        document.head.appendChild(script);
      }
      if (localStorage.getItem('analytics-consent') === 'accepted') loadAnalytics();
    </script>
    <script is:inline>
      const storedTheme = localStorage.getItem('theme');
      if (storedTheme) document.documentElement.dataset.theme = storedTheme;
    </script>
  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <nav class="main-links" aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/projects/">Projects</a>
          <a href="/tags/">Tags</a>
        </nav>
        <div class="header-actions">
          <a class="icon-link" href="https://github.com/Rassilion/" rel="me" aria-label="Rassilion on GitHub">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.74-1.55-2.57-.3-5.27-1.29-5.27-5.69 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.16 1.18A10.9 10.9 0 0 1 12 6.11c.98 0 1.96.13 2.88.39 2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.12 3.05.73.81 1.17 1.83 1.17 3.09 0 4.42-2.7 5.39-5.28 5.68.42.36.79 1.07.79 2.16v3.24c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"/></svg>
          </a>
          <button class="theme-toggle" type="button" aria-label="Switch to light theme">
            <span class="theme-icon theme-icon-moon" aria-hidden="true">🌙</span>
            <span class="theme-icon theme-icon-sun" aria-hidden="true">☀️</span>
          </button>
        </div>
      </header>
      <main><slot /></main>
      <footer class="site-footer">© {new Date().getFullYear()} Built with <a href="https://astro.build/">Astro</a></footer>
    </div>
    <aside class="consent-banner" hidden aria-label="Analytics preference">
      <p>This site uses privacy-friendly analytics to understand visits.</p>
      <div><button type="button" data-consent="declined">No thanks</button><button class="primary" type="button" data-consent="accepted">Allow analytics</button></div>
    </aside>
    <script>
      document.querySelector('.theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.dataset.theme === 'light' ? 'dark' : 'light';
        root.dataset.theme = next;
        localStorage.setItem('theme', next);
        document.querySelector('.theme-toggle')?.setAttribute('aria-label', next === 'light' ? 'Switch to dark theme' : 'Switch to light theme');
      });
      const consent = document.querySelector<HTMLElement>('.consent-banner');
      if (consent && !localStorage.getItem('analytics-consent')) consent.hidden = false;
      document.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((button) => button.addEventListener('click', () => {
        const choice = button.dataset.consent ?? 'declined';
        localStorage.setItem('analytics-consent', choice);
        if (choice === 'accepted') (window as any).loadAnalytics?.();
        if (consent) consent.hidden = true;
      }));
    </script>
  </body>
</html>
